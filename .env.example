# Hermes Flux 环境变量样例
#
# 用法：复制为 .env（已在 .gitignore 中忽略），或用系统环境变量注入。
# 铁律：本仓库任何文件都不得写入真实网关地址、账号或密码。

# ── 网关契约同步（离线，读本地网关仓库） ──────────────────────────────
# 指向 hermes-agent 仓库根目录，用于生成 packages/core/src/rpc/contracts/*
HERMES_GATEWAY_REPO=

# ── 真实网关探针（在线，录 fixture 用） ────────────────────────────────
# 仅在你需要重新录制真实响应时填写；CI 不依赖这些变量。
HERMES_GATEWAY_URL=
HERMES_GATEWAY_USER=
HERMES_GATEWAY_PASSWORD=
# 可选：指定探测用的 profile，缺省取网关的 default
HERMES_GATEWAY_PROFILE=

# ── 本地 Python 网关联调（test:live-gateway） ──────────────────────────
# 两个都配置且路径存在时才会执行，否则整组 skip。
HERMES_GATEWAY_PYTHON=
# 与上面的 HERMES_GATEWAY_REPO 相同，可复用

# ── 运行期开关 ────────────────────────────────────────────────────────
# 关闭 RPC 契约守卫（仅限排障，禁止长期关闭）
FLUX_CONTRACT_GUARD=1
# 日志级别：文件默认 debug，控制台默认 info
FUS_LOG_LEVEL=

# ── 真实网关端到端 / CDP 联调（packages/desktop/__tests__/e2e） ────────
FLUX_GATEWAY_URL=
FLUX_GATEWAY_USER=
FLUX_GATEWAY_PASS=

# ── 远程 Mac 测试节点（scripts/remote/run-mac-test.mjs） ───────────────
# 格式: user@ip，用于驱动远程无头 Mac 执行 macOS/iOS 端到端测试
MAC_RUNNER_SSH=
MAC_RUNNER_WORKSPACE=~/workspace/hermes-flux

# ── 全端严格发行签名开关（设为 1 时缺失签名/公证立即失败，禁止静默降级） ───
FLUX_REQUIRE_SIGNING=

# ── Android Release 正式签名（优先读取 packages/mobile/android/keystore.properties） ─
# 严禁将真实 keystore 密码或文件提交至版本库
ANDROID_REQUIRE_RELEASE_SIGNING=
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# ── iOS Release 正式签名与导出（可选，也可写至 packages/mobile/ios/signing.local.xcconfig） ─
IOS_REQUIRE_SIGNING=
IOS_DEVELOPMENT_TEAM=
IOS_SIGNING_STYLE=automatic
IOS_EXPORT_METHOD=app-store-connect
IOS_CODE_SIGN_IDENTITY=
IOS_PROVISIONING_PROFILE_SPECIFIER=

# ── macOS Developer ID 签名与 Apple 公证（Notarization） ────────────────
MAC_REQUIRE_SIGNING=
# 方式 A：base64 或本地 .p12 路径 + 口令；方式 B：本机 Keychain 证书名（CSC_NAME）
CSC_LINK=
CSC_KEY_PASSWORD=
CSC_NAME=
# 公证方式 1（推荐 CI）：App Store Connect API Key（.p8 文件路径或 base64）
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
# 公证方式 2：Apple ID + App 专用密码 + Team ID
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
# 公证方式 3：本机 notarytool keychain profile
APPLE_KEYCHAIN_PROFILE=

# ── Windows Authenticode / Azure Artifact Signing ────────────────────────
WIN_REQUIRE_SIGNING=
# 方式 1（推荐，直接获得 Microsoft SmartScreen 信任）：Azure Artifact Signing
AZURE_SIGNING_ENDPOINT=
AZURE_SIGNING_ACCOUNT_NAME=
AZURE_SIGNING_CERT_PROFILE_NAME=
AZURE_SIGNING_PUBLISHER_NAME=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_FEDERATED_TOKEN_FILE=
AZURE_USE_CLI_AUTH=
# 方式 2：PFX/P12 证书文件或 base64 + 口令
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=
# 方式 3：Windows 证书存储（EV 硬件加密狗 / 本机证书指纹或主题名）
WIN_CSC_SHA1=
WIN_CSC_SUBJECT_NAME=
