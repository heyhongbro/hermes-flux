# Hermes Flux Environment Variables Example
#
# Usage: copy to .env (ignored by .gitignore) or inject via system environment variables.
# Rule: never commit real gateway URLs, usernames, passwords, keys, or tokens to this repository.

# -- Gateway Contract Sync (offline, reads local gateway repo) ----------------
# Path to hermes-agent repo root used to generate packages/core/src/rpc/contracts/*
HERMES_GATEWAY_REPO=

# -- Live Gateway Probe (online, for recording fixtures) ----------------------
# Fill only when re-recording live gateway responses; CI does not require these variables.
HERMES_GATEWAY_URL=
HERMES_GATEWAY_USER=
HERMES_GATEWAY_PASSWORD=
# Optional: target profile for probing (defaults to gateway 'default')
HERMES_GATEWAY_PROFILE=

# -- Local Python Gateway Integration (test:live-gateway) ---------------------
# Runs only when both paths are configured and exist; otherwise skipped.
HERMES_GATEWAY_PYTHON=
# Reuses HERMES_GATEWAY_REPO above

# -- Runtime Switches ---------------------------------------------------------
# Disable RPC contract guard (debugging only; keep enabled in normal runs)
FLUX_CONTRACT_GUARD=1
# Log level: file defaults to debug, console defaults to info
FUS_LOG_LEVEL=

# -- Live Gateway E2E / CDP Tests (packages/desktop/__tests__/e2e) ------------
FLUX_GATEWAY_URL=
FLUX_GATEWAY_USER=
FLUX_GATEWAY_PASS=

# -- Remote macOS Test Runner (scripts/remote/run-mac-test.mjs) ---------------
# Format: user@ip for driving headless macOS/iOS E2E verification
MAC_RUNNER_SSH=
MAC_RUNNER_WORKSPACE=~/workspace/hermes-flux

# -- Strict Cross-Platform Release Signing Gate -------------------------------
# Set to 1 to fail immediately if release signing/notarization credentials are missing
FLUX_REQUIRE_SIGNING=

# -- Android Release Signing (prefers packages/mobile/android/keystore.properties)
# Never commit real keystore files or passwords
ANDROID_REQUIRE_RELEASE_SIGNING=
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# -- iOS Release Signing & Export (or set in packages/mobile/ios/signing.local.xcconfig)
IOS_REQUIRE_SIGNING=
IOS_DEVELOPMENT_TEAM=
IOS_SIGNING_STYLE=automatic
IOS_EXPORT_METHOD=app-store-connect
IOS_CODE_SIGN_IDENTITY=
IOS_PROVISIONING_PROFILE_SPECIFIER=

# -- macOS Developer ID Signing & Apple Notarization --------------------------
MAC_REQUIRE_SIGNING=
# Option A: base64 or local .p12 path + password; Option B: Keychain identity name (CSC_NAME)
CSC_LINK=
CSC_KEY_PASSWORD=
CSC_NAME=
# Notarization Option 1 (recommended for CI): App Store Connect API Key (.p8 path or base64)
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
# Notarization Option 2: Apple ID + App-Specific Password + Team ID
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
# Notarization Option 3: local notarytool keychain profile
APPLE_KEYCHAIN_PROFILE=

# -- Windows Authenticode / Azure Artifact Signing ----------------------------
WIN_REQUIRE_SIGNING=
# Option 1 (recommended for SmartScreen trust): Azure Artifact Signing
AZURE_SIGNING_ENDPOINT=
AZURE_SIGNING_ACCOUNT_NAME=
AZURE_SIGNING_CERT_PROFILE_NAME=
AZURE_SIGNING_PUBLISHER_NAME=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_FEDERATED_TOKEN_FILE=
AZURE_USE_CLI_AUTH=
# Option 2: PFX/P12 certificate file or base64 + password
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=
# Option 3: Windows certificate store (EV hardware token / SHA-1 thumbprint or subject name)
WIN_CSC_SHA1=
WIN_CSC_SUBJECT_NAME=
