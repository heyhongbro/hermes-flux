{
  "appId": "com.hermesflux.app",
  "appName": "Hermes Flux",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "contentInset": "never",
    "preferredContentMode": "mobile",
    "allowsLinkPreview": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "StatusBar": {
      "overlaysWebView": true
    },
    "SystemBars": {
      "initialViewportFitValueHint": "cover"
    },
    "Keyboard": {
      "resize": "none"
    }
  }
}
